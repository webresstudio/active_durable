# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

%w[actionpack actionview activejob activerecord activesupport railties].each { |name| gem name, "~> 8.0.0" }
gem "json", "< 3" # Active Support 8.0 still passes quirks_mode to JSON.generate, which json 3 removed
gem "sqlite3", ">= 2.1"
gem "trilogy", "~> 2.9" # MySQL

eval_gemfile "shared.gemfile"
