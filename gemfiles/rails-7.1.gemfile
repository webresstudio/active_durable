# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

%w[actionpack actionview activejob activerecord activesupport railties].each { |name| gem name, "~> 7.1.0" }
gem "json", "< 3" # Active Support 7.1 still passes quirks_mode to JSON.generate, which json 3 removed
gem "sqlite3", ">= 1.4"

eval_gemfile "shared.gemfile"
