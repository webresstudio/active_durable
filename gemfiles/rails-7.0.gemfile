# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

%w[actionpack actionview activejob activerecord activesupport railties].each { |name| gem name, "~> 7.0.0" }
gem "json", "< 3" # Active Support 7.0 still passes quirks_mode to JSON.generate, which json 3 removed
gem "mysql2", "~> 0.5" # MySQL: trilogy only ships with Active Record 7.1+
gem "sqlite3", "~> 1.4" # Active Record 7.0 does not support sqlite3 2.x

eval_gemfile "shared.gemfile"
