# frozen_string_literal: true

# ActiveDurable 0.7: MySQL compared ids and step names ignoring case and accents, so "order-abc" and "order-ÁBC"
# shared one saga. These columns now compare byte by byte, as on PostgreSQL and SQLite. Elsewhere it does nothing.
#
# On MySQL it rebuilds the three tables and blocks writes to them while it runs: run it at a quiet time, or prune
# first. MySQL cannot roll DDL back, so if it stops halfway, run it again: it finishes the columns and puts the
# foreign keys back.
class MakeActiveDurableIdsCaseSensitive < ActiveRecord::Migration<%= migration_version %>
  COLUMNS = {
    durable_executions: %w[id forked_from],
    durable_steps: %w[execution_id name],
    durable_signals: %w[execution_id name]
  }.freeze

  def up
    change_collation { |_table| "utf8mb4_bin" }
  end

  def down
    change_collation { |table| table_collation(table) }
  end

  private

  def change_collation
    return unless connection.adapter_name.match?(/mysql|trilogy/i)

    changes = COLUMNS.flat_map do |table, names|
      wanted = yield(table)
      connection.columns(table).select { |column| names.include?(column.name) && column.collation != wanted }
                .map { |column| [table, column, wanted] }
    end

    # Both ends of a foreign key must share a collation, so the keys come off while the columns change.
    on_delete = remove_foreign_keys if changes.any?
    changes.each do |table, column, collation|
      change_column table, column.name, :string, limit: column.limit, null: column.null, collation: collation
    end
    restore_foreign_keys(on_delete || {})
  end

  FOREIGN_KEY_TABLES = %i[durable_steps durable_signals].freeze

  def foreign_key(table)
    connection.foreign_keys(table).find { |key| key.column == "execution_id" }
  end

  def remove_foreign_keys
    FOREIGN_KEY_TABLES.each_with_object({}) do |table, on_delete|
      key = foreign_key(table)
      next unless key

      on_delete[table] = key.options[:on_delete]
      remove_foreign_key table, column: :execution_id
    end
  end

  # Also puts back keys that an earlier run, stopped halfway, left off.
  def restore_foreign_keys(on_delete)
    FOREIGN_KEY_TABLES.each do |table|
      next if foreign_key(table)

      add_foreign_key table, :durable_executions, column: :execution_id, on_delete: on_delete.fetch(table, :cascade)
    end
  end

  def table_collation(table)
    select_value("SELECT TABLE_COLLATION FROM information_schema.TABLES " \
                 "WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = #{connection.quote(table.to_s)}")
  end
end
